# Ayush Environment Variables
# Copy to .env and fill in your values

# MongoDB (use MongoDB Atlas free tier)
# Format: mongodb+srv://username:password@cluster.mongodb.net/ayush?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_uri_here

# AI Services (at least one required for prescription parsing)
# Google Gemini 1.5 Flash (primary)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (fallback)
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM (fallback)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Email (SMTP) - for notifications
# Gmail example: smtp.gmail.com:587 with app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Ayush Care

# JWT Secret (auto-generated in production, set manually for dev)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Server
PORT=8000
ENVIRONMENT=development

# CORS Origins (comma-separated)
# Add your frontend URL(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Redis for caching/sessions
REDIS_URL=

# Optional: Sentry for error tracking
SENTRY_DSN=
